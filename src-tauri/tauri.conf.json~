{
  "$schema": "https://raw.githubusercontent.com/nicbarker/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "vcompare",
  "version": "0.1.0",
  "identifier": "com.vcompare.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "vcompare",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [],
    "externalBin": [
      "binaries/vcompare_engine"
    ]
  }
}
